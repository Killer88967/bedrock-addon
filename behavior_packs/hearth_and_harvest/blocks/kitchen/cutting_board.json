{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "hh:cutting_board",
      "menu_category": { "category": "items" },
      "states": {
        "hh:ingredient": [
          "none",
          "tomato",
          "onion",
          "lettuce",
          "bread",
          "porkchop",
          "cooked_porkchop"
        ]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "hh:cutting_board": {},
      "minecraft:geometry": {
        "identifier": "geometry.hh.cutting_board",
        "bone_visibility": {
          "tomato": "q.block_state('hh:ingredient') == 'tomato'",
          "onion": "q.block_state('hh:ingredient') == 'onion'",
          "lettuce": "q.block_state('hh:ingredient') == 'lettuce'",
          "bread": "q.block_state('hh:ingredient') == 'bread'",
          "porkchop": "q.block_state('hh:ingredient') == 'porkchop'",
          "cooked_porkchop": "q.block_state('hh:ingredient') == 'cooked_porkchop'"
        }
      },
      "minecraft:material_instances": {
        "*": { "texture": "hh_cutting_board", "render_method": "opaque" }
      },
      "minecraft:collision_box": { "origin": [-6, 0, -6], "size": [12, 1, 12] },
      "minecraft:selection_box": { "origin": [-6, 0, -6], "size": [12, 4, 12] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0.5 },
      "minecraft:flammable": { "catch_chance_modifier": 5, "destroy_chance_modifier": 20 },
      "minecraft:light_dampening": 0,
      "minecraft:placement_filter": { "conditions": [{ "allowed_faces": ["up"] }] },
      "tag:minecraft:is_axe_item_destructible": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": { "minecraft:transformation": { "rotation": [0, 0, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": { "minecraft:transformation": { "rotation": [0, 270, 0] } }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } }
      }
    ]
  }
}
