{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "hh:lettuce_crop",
      "menu_category": {
        "category": "none"
      },
      "states": {
        "hh:growth": [0, 1, 2, 3, 4, 5, 6, 7]
      }
    },
    "components": {
      "hh:crop": {
        "max_growth": 7,
        "growth_chance": 0.35
      },
      "minecraft:geometry": "geometry.hh.crop",
      "minecraft:material_instances": {
        "*": {
          "texture": "hh_lettuce_crop_stage_0",
          "render_method": "alpha_test",
          "ambient_occlusion": 0,
          "face_dimming": false
        }
      },
      "minecraft:collision_box": false,
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 3, 16]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0
      },
      "minecraft:light_dampening": 0,
      "minecraft:placement_filter": {
        "conditions": [
          {
            "allowed_faces": ["up"],
            "block_filter": ["minecraft:farmland"]
          }
        ]
      },
      "minecraft:loot": "loot_tables/blocks/crops/lettuce_crop_young.json"
    },
    "permutations": [
      {
        "condition": "q.block_state('hh:growth') >= 2 && q.block_state('hh:growth') <= 3",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "hh_lettuce_crop_stage_1",
              "render_method": "alpha_test",
              "ambient_occlusion": 0,
              "face_dimming": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-8, 0, -8],
            "size": [16, 5, 16]
          }
        }
      },
      {
        "condition": "q.block_state('hh:growth') >= 4 && q.block_state('hh:growth') <= 6",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "hh_lettuce_crop_stage_2",
              "render_method": "alpha_test",
              "ambient_occlusion": 0,
              "face_dimming": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-8, 0, -8],
            "size": [16, 7, 16]
          }
        }
      },
      {
        "condition": "q.block_state('hh:growth') == 7",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "hh_lettuce_crop_stage_3",
              "render_method": "alpha_test",
              "ambient_occlusion": 0,
              "face_dimming": false
            }
          },
          "minecraft:selection_box": {
            "origin": [-8, 0, -8],
            "size": [16, 9, 16]
          },
          "minecraft:loot": "loot_tables/blocks/crops/lettuce_crop_mature.json"
        }
      }
    ]
  }
}
