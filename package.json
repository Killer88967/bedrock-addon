{
  "name": "hearth-and-harvest",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "lint": "just-scripts lint",
    "lint:fix": "just-scripts lint --fix",
    "typecheck": "tsc --noEmit",
    "build": "just-scripts build",
    "build:production": "just-scripts build --production",
    "clean": "just-scripts clean",
    "gen": "npm run gen:crops && npm run gen:foods && npm run gen:plate && npm run gen:textures",
    "gen:crops": "node tools/gen-crops.mjs && prettier --write behavior_packs resource_packs --log-level warn",
    "gen:foods": "node tools/gen-foods.mjs && prettier --write behavior_packs resource_packs --log-level warn",
    "gen:textures": "node tools/gen-placeholder-textures.mjs",
    "gen:plate": "node tools/gen-plate.mjs && prettier --write behavior_packs resource_packs --log-level warn",
    "mcaddon": "just-scripts mcaddon",
    "mcaddon:production": "just-scripts mcaddon --production"
  },
  "dependencies": {
    "@minecraft/math": "^2.4.1",
    "@minecraft/server": "^2.10.0",
    "@minecraft/server-ui": "^2.2.0",
    "@minecraft/vanilla-data": "^1.26.52"
  },
  "devDependencies": {
    "@minecraft/core-build-tasks": "^5.7.1",
    "eslint-plugin-minecraft-linting": "^2.0.13",
    "just-scripts": "^2.6.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
